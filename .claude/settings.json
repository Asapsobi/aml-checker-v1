{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy)",
      "Bash(uv run mypy *)",
      "Bash(uv lock)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(~/.amlcheck/.env)"
    ]
  }
}
