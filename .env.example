# amlcheck keys: RPC providers and indexers only (no third-party AML API, D-033).
# Copy to `.env` (this folder) or `~/.amlcheck/.env` and fill in.
# Order: environment variables win, then ./.env, then ~/.amlcheck/.env.
# Never commit `.env`. Keys are never written to config.toml, logs or the audit log.

# TronGrid (TRON chain data). Free key: https://www.trongrid.io/
AMLCHECK_TRONGRID_API_KEY=

# Envio HyperSync (BSC chain data). Free token: https://envio.dev/app/api-tokens
AMLCHECK_HYPERSYNC_TOKEN=

# Local API token (P10), at least 32 characters. Leave empty until then.
AMLCHECK_API_TOKEN=

# Tronscan (TRON account tags, P14, D-087). Free key: https://tronscan.org (account → API keys).
AMLCHECK_TRONSCAN_API_KEY=
